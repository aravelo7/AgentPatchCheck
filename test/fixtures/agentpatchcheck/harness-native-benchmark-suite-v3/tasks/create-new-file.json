{
  "version": 1,
  "repositoryRoot": "../fixture-repository",
  "promptFile": "prompts/create-new-file.txt",
  "agentAdapter": "harness-native",
  "model": "__AGENTPATCHCHECK_MODEL__",
  "nativeAgent": {
    "provider": "openai",
    "protocol": "responses",
    "credentialRef": "openai-primary",
    "maxIterations": 6,
    "maxToolCalls": 8,
    "maxObservationBytes": 4096
  },
  "timeoutMs": 120000,
  "sandbox": "workspace-write",
  "allowNetwork": true,
  "patchExpectation": "changes-required",
  "verificationProfile": "new-file-prefix",
  "riskPolicyProfile": "policies/suite-risk.json",
  "hiddenOracle": {
    "script": "scripts/oracle-new-file-exact.mjs",
    "isolation": "none"
  }
}
